# Leave OPENAI_API_KEY empty to use deterministic Mock AI Mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Dedicated Node render service. Keep the token server-side.
RENDER_SERVICE_URL=http://127.0.0.1:4100
RENDER_API_TOKEN=
RENDER_SERVER_HOST=127.0.0.1
RENDER_SERVER_PORT=4100
RENDER_MAX_PENDING=3
RENDER_RETENTION_MINUTES=30
# Mount this directory on persistent storage in a deployed single-node renderer.
RENDER_OUTPUT_DIR=output/jobs
