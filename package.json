{
  "name": "explain-motion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:visual": "tsx scripts/visual-regression.ts",
    "test:visual:update": "tsx scripts/visual-regression.ts --update",
    "studio": "remotion studio src/remotion/index.ts",
    "render": "npm run render:sample",
    "render:sample": "remotion render src/remotion/index.ts ExplainMotion output/explain-motion.mp4 --codec=h264",
    "render:server": "tsx server/render-service.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/noto-sans-jp": "^5.3.0",
    "@remotion/bundler": "4.0.525",
    "@remotion/captions": "4.0.525",
    "@remotion/cli": "4.0.525",
    "@remotion/player": "4.0.525",
    "@remotion/renderer": "4.0.525",
    "@remotion/transitions": "4.0.525",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "openai": "^7.15.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.525",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
